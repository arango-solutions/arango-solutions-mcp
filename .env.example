# ArangoDB Connection (required)
ARANGO_HOSTS=http://localhost:8529
ARANGO_ROOT_USERNAME=root
ARANGO_ROOT_PASSWORD=          # <-- set your password here

# ArangoDB Options (optional)
ARANGO_DEFAULT_DB_NAME=_system
ARANGO_VERIFY_SSL=true
ARANGO_SSL_CERT_PATH=

# MCP Server (optional)
SERVER_NAME=ArangoDB MCP Server
SERVER_VERSION=2.0.0
LOG_LEVEL=INFO
LOG_FORMAT=text                # text | json   (json = one-line JSON per record, for log aggregation)
MCP_TRANSPORT=stdio            # stdio | sse | streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PROTOCOL_MODE=auto         # strict | auto | legacy
MCP_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
MCP_PROFILE=readonly           # readonly | developer | operator | admin
MCP_TOOLSETS=                  # optional comma-separated graph,search additions
MCP_DENIED_TOOLS=              # optional comma-separated exact tool names
MCP_DENIED_CATEGORIES=         # optional comma-separated catalog categories
MCP_RESULT_CONTRACT=v3         # v3 | legacy (legacy expires 2027-02-01)
MCP_LEGACY_ACTOR_ID=legacy-http
MCP_CONFIRMATION_SECRET=       # trusted operator HMAC key; never expose to MCP clients
MCP_HTTP_PORT=8000             # Docker Compose host port
ARANGO_HTTP_PORT=8529          # Docker Compose host port

# Feature Flags
ENABLE_JS_TRANSACTIONS=false   # WARNING: allows arbitrary JS on the DB server

# AQL safety
DEFAULT_AQL_MAX_RUNTIME=30     # seconds; hard-clamped to non-disableable 30s maximum
LOG_AQL_QUERIES=false          # true logs first 100 chars of user-supplied AQL (may contain literals)

# Connection resilience
CONNECT_MAX_RETRIES=5          # 0 disables retries
CONNECT_INITIAL_BACKOFF=1.0    # seconds; doubled per attempt, capped at 30s

# HTTP transport auth (sse / streamable-http)
# Choose exactly one production mode: legacy static bearer OR OIDC below.
# One mode is REQUIRED when MCP_HOST is non-loopback.
# Generate an independent token with: openssl rand -hex 32
# Never reuse ARANGO_ROOT_PASSWORD as the MCP token.
MCP_AUTH_TOKEN=

# OAuth 2.1 / OIDC resource-server mode (preferred for production HTTP)
MCP_OIDC_ISSUER=                     # exact issuer from access-token "iss"
MCP_OIDC_AUDIENCE=                   # required access-token "aud"
MCP_RESOURCE_URL=                    # canonical URL, e.g. https://mcp.example/mcp
MCP_OIDC_ALGORITHMS=RS256            # asymmetric algorithms only; comma-separated
MCP_OIDC_ACTOR_CLAIM=sub
MCP_OIDC_DATABASE_CLAIM=arangodb_databases
MCP_OIDC_CLOCK_SKEW_SECONDS=30
MCP_OIDC_CACHE_TTL_SECONDS=300
MCP_OIDC_ALLOW_INSECURE_HTTP=false    # test/dev only; constrained private/container HTTP names
# Trusted server-side actor mapping. Prefer password_env over inline password.
# Example: {"alice":{"username":"alice_mcp","password_env":"ARANGO_ALICE_PASSWORD","databases":["tenant_a"]}}
# The token can narrow these databases but can never supply or expand credentials.
MCP_ARANGO_CREDENTIALS_JSON=

# Operations and observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_TRACES_EXPORTER=none             # none | otlp (OTLP uses HTTP/protobuf)
OTEL_SERVICE_NAME=arangodb-mcp-server
OTEL_SERVICE_VERSION=2.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=           # secret comma-separated key=value headers
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
MCP_ACTOR_RATE_LIMIT_PER_MINUTE=600
MCP_ACTOR_RATE_LIMIT_BURST=200
MCP_GLOBAL_MAX_CONCURRENCY=64
MCP_CLASS_CONCURRENCY_LIMITS=standard=32,query=16,bulk=8,control=4,external=8
MCP_LIMITER_RETRY_AFTER_MS=250

# Embeddings / shared-memory pattern tools (optional)
# Used by embed-text, embed-document, pattern-search and save-pattern. When
# OPENAI_API_KEY is unset these tools degrade gracefully (pattern-search falls
# back to BM25 keyword search; save-pattern defers the vector) and the core
# database tools are unaffected.
OPENAI_API_KEY=                        # OpenAI API key for the embeddings endpoint
EMBEDDING_MODEL=text-embedding-3-small # 1536 dimensions
