FROM python:3.11.13-slim-bookworm

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --requirement requirements.txt && \
    useradd --system --uid 10001 --no-create-home reference-idp
COPY reference_idp.py .

USER 10001
EXPOSE 8080
HEALTHCHECK --interval=2s --timeout=2s --start-period=3s --retries=30 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=1)"]
CMD ["python", "reference_idp.py"]
