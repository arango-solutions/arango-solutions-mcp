{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ArangoDB MCP Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "auth", "arango", "secrets", "policy", "server", "observability"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automountServiceAccountToken", "annotations", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "automountServiceAccountToken": {"type": "boolean"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "name": {"type": "string"}
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "targetPort", "annotations"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": {"type": "string"},
                    "pathType": {"enum": ["Exact", "Prefix", "ImplementationSpecific"]}
                  }
                }
              }
            }
          }
        },
        "tls": {"type": "array", "items": {"type": "object"}}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "legacy", "oidc"],
      "properties": {
        "mode": {"enum": ["legacy", "oidc"]},
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId"],
          "properties": {"actorId": {"type": "string", "minLength": 1}}
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "audience", "resourceUrl", "algorithms", "actorClaim", "databaseClaim", "clockSkewSeconds", "cacheTtlSeconds", "allowInsecureHttp"],
          "properties": {
            "issuer": {"type": "string"},
            "audience": {"type": "string"},
            "resourceUrl": {"type": "string"},
            "algorithms": {"type": "string", "minLength": 1},
            "actorClaim": {"type": "string", "minLength": 1},
            "databaseClaim": {"type": "string", "minLength": 1},
            "clockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
            "cacheTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "allowInsecureHttp": {"type": "boolean"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "oidc"}}},
          "then": {
            "properties": {
              "oidc": {"required": ["issuer", "audience", "resourceUrl"], "properties": {"issuer": {"minLength": 1}, "audience": {"minLength": 1}, "resourceUrl": {"minLength": 1}}}
            }
          }
        }
      ]
    },
    "arango": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "username", "database", "verifySsl", "sslCertPath"],
      "properties": {
        "hosts": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "verifySsl": {"type": "boolean"},
        "sslCertPath": {"type": "string"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "keys", "extraEnv", "create"],
      "properties": {
        "existingSecret": {"type": "string"},
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arangoPassword", "authToken", "oidcCredentials", "confirmationSecret", "otelHeaders", "openaiApiKey"],
          "properties": {
            "arangoPassword": {"type": "string", "minLength": 1},
            "authToken": {"type": "string", "minLength": 1},
            "oidcCredentials": {"type": "string", "minLength": 1},
            "confirmationSecret": {"type": "string", "minLength": 1},
            "otelHeaders": {"type": "string", "minLength": 1},
            "openaiApiKey": {"type": "string", "minLength": 1}
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "key"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "key": {"type": "string", "minLength": 1}
            }
          }
        },
        "create": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "arangoPassword", "authToken", "oidcCredentials", "confirmationSecret", "otelHeaders", "openaiApiKey", "extraData"],
          "properties": {
            "enabled": {"type": "boolean"},
            "arangoPassword": {"type": "string"},
            "authToken": {"type": "string"},
            "oidcCredentials": {"type": "string"},
            "confirmationSecret": {"type": "string"},
            "otelHeaders": {"type": "string"},
            "openaiApiKey": {"type": "string"},
            "extraData": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "toolsets", "deniedTools", "deniedCategories", "resultContract", "enableJsTransactions", "defaultAqlMaxRuntime", "logAqlQueries", "actorRateLimitPerMinute", "actorRateLimitBurst", "globalMaxConcurrency", "classConcurrencyLimits", "limiterRetryAfterMs", "confirmationSecretEnabled"],
      "properties": {
        "profile": {"enum": ["readonly", "developer", "operator", "admin"]},
        "toolsets": {"type": "string"},
        "deniedTools": {"type": "string"},
        "deniedCategories": {"type": "string"},
        "resultContract": {"enum": ["v3", "legacy"]},
        "enableJsTransactions": {"type": "boolean"},
        "defaultAqlMaxRuntime": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "logAqlQueries": {"type": "boolean"},
        "actorRateLimitPerMinute": {"type": "integer", "minimum": 1},
        "actorRateLimitBurst": {"type": "integer", "minimum": 1},
        "globalMaxConcurrency": {"type": "integer", "minimum": 1},
        "classConcurrencyLimits": {"type": "string", "minLength": 1},
        "limiterRetryAfterMs": {"type": "integer", "minimum": 1},
        "confirmationSecretEnabled": {"type": "boolean"}
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logLevel", "logFormat", "protocolMode", "dnsRebindingProtection", "allowedHosts", "allowedOrigins", "connectMaxRetries", "connectInitialBackoff"],
      "properties": {
        "logLevel": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]},
        "logFormat": {"enum": ["text", "json"]},
        "protocolMode": {"enum": ["strict", "auto", "legacy"]},
        "dnsRebindingProtection": {"type": "boolean"},
        "allowedHosts": {"type": "string"},
        "allowedOrigins": {"type": "string"},
        "connectMaxRetries": {"type": "integer", "minimum": 0},
        "connectInitialBackoff": {"type": "number", "minimum": 0}
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "serviceMonitor", "tracing"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path"],
          "properties": {
            "enabled": {"type": "boolean"},
            "path": {"type": "string", "pattern": "^/"}
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespace", "interval", "scrapeTimeout", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "namespace": {"type": "string"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exporter", "serviceName", "serviceVersion", "endpoint", "timeoutSeconds", "headersSecretEnabled"],
          "properties": {
            "exporter": {"enum": ["none", "otlp"]},
            "serviceName": {"type": "string", "minLength": 1},
            "serviceVersion": {"type": "string", "minLength": 1},
            "endpoint": {"type": "string", "minLength": 1},
            "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
            "headersSecretEnabled": {"type": "boolean"}
          }
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "model"],
      "properties": {
        "enabled": {"type": "boolean"},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": {"$ref": "#/definitions/probe"},
        "readiness": {"$ref": "#/definitions/probe"}
      }
    },
    "resources": {"type": "object"},
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]},
        "maxUnavailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}, {"type": "null"}]}
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "extraEnv": {"type": "array"},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    }
  }
}
